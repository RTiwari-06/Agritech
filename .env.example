# --- Core app ---
# Flask server-side secret. MUST be replaced in production.
SECRET_KEY=change-me-in-production
DEBUG=true
HOST=0.0.0.0
PORT=5000
SQL_ECHO=false

# --- Database ---
# Default: SQLite file under data/ (auto-created).
# For PostgreSQL, swap in e.g.:
#   DATABASE_URI=postgresql+psycopg2://agritech:PASSWORD@localhost:5432/agritech
DATABASE_URI=

# Optional: if set, this overrides DATABASE_URI (handy for prod/ci separation).
PG_DATABASE_URI=

# Optional MongoDB for telemetry / product embeddings.
MONGO_URI=
MONGO_DB=agritech

# --- NLP ---
NLP_MODEL=en_core_web_sm
# Automatically run `python -m spacy download <model>` when the model is missing.
AUTO_DOWNLOAD_NLP_MODEL=false
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
# Use the transformers sentiment pipeline instead of the built-in lexicon scorer.
USE_TRANSFORMER_SENTIMENT=false

# --- Twilio SMS ---
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Public origin used by the Streamlit frontend ---
API_BASE_URL=http://localhost:5000