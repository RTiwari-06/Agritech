# --- Core app ---
SECRET_KEY=change-me-in-production
DEBUG=true
# Flask must bind the loopback interface only (see phase_integration_specification.md).
HOST=127.0.0.1
PORT=5000
SQL_ECHO=false
# Project-scoped values override globally defined HOST/API_BASE_URL settings.
AGRITECH_HOST=127.0.0.1
AGRITECH_API_BASE_URL=http://127.0.0.1:5000

# --- Database: MongoDB (primary data store) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=agritech
DATABASE_BACKEND=mongo

# --- Legacy SQL (unused unless DATABASE_BACKEND=sql) ---
DATABASE_URI=
PG_DATABASE_URI=

# --- NLP ---
NLP_MODEL=en_core_web_sm
AUTO_DOWNLOAD_NLP_MODEL=true
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
INTENT_MODEL=facebook/bart-large-mnli
USE_TRANSFORMER_SENTIMENT=false
# Opt-in transformer zero-shot intent (bart-large-mnli is slow on CPU; the
# keyword matcher used otherwise is instant and covers the seeded intents).
USE_TRANSFORMER_INTENT=false

# --- Twilio SMS ---
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Public origin used by the Streamlit frontend (loopback REST engine) ---
API_BASE_URL=http://127.0.0.1:5000
