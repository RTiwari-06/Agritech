# --- Core app ---
SECRET_KEY=change-me-in-production
DEBUG=true
HOST=0.0.0.0
PORT=5000
SQL_ECHO=false

# --- Database: MongoDB (primary data store) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=agritech
DATABASE_BACKEND=mongo

# --- Legacy SQL (unused unless DATABASE_BACKEND=sql) ---
DATABASE_URI=
PG_DATABASE_URI=

# --- NLP ---
NLP_MODEL=en_core_web_sm
AUTO_DOWNLOAD_NLP_MODEL=true
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
INTENT_MODEL=facebook/bart-large-mnli
USE_TRANSFORMER_SENTIMENT=false

# --- Twilio SMS ---
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Public origin used by the Streamlit frontend ---
API_BASE_URL=http://localhost:5000
